{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Progress",
  "version": "1.0.0",
  "identifier": "com.ahmedgraja.taskprogress",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Task Progress",
        "width": 1480,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#F6F7FA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}